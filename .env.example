APP_NAME=SFconnecting
APP_ENV=local
APP_KEY=
# ⚠ En producción: APP_ENV=production y APP_DEBUG=false (AppServiceProvider::boot()
# aborta el arranque si detecta production+debug, pero no dejes que dependa solo de eso).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# ⚠ En producción: LOG_LEVEL=error (o warning) — en debug se registran queries y payloads completos.
LOG_LEVEL=debug

# ─── Base de datos principal (MySQL) ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sfconnecting
DB_USERNAME=root
DB_PASSWORD=

# ─── ERP Contiflex - SQL Server (solo lectura) ────────────────────────────────
# Sin esta conexión el CRM funciona en modo degradado (sin datos de ventas ERP).
# Solicitar credenciales al administrador del sistema Contiflex.
ERP_CONNECTION=sqlsrv
ERP_HOST=
ERP_PORT=1433
ERP_DATABASE=
ERP_USERNAME=
ERP_PASSWORD=

# ─── Configuración CRM ────────────────────────────────────────────────────────
# Número de compañía en SIESA/Contiflex (consultar con sistemas)
CRM_COMPANIA=1

# ─── n8n (notificación de cartera) ────────────────────────────────────────────
# Token que n8n envía como "Authorization: Bearer ..." para consumir
# GET /api/cartera/pendientes y PATCH /api/cartera/{compania}/{nroDocumento}/notificar
# en vez de conectarse directo al SQL Server del ERP. Generar uno nuevo con:
# php artisan tinker --execute="echo Str::random(40);"
N8N_API_TOKEN=

# ─── Sesión / Caché ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Redis (opcional) ─────────────────────────────────────────────────────────
# El stack de docker-compose ya trae un servicio "redis" (extensión phpredis
# incluida en la imagen). Para usarlo en vez de "database", cambia arriba
# SESSION_DRIVER, CACHE_STORE y QUEUE_CONNECTION a "redis" y REDIS_HOST a "redis".
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
